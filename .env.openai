# ==========================================
# Configuración para OPENAI (Cloud)
# ==========================================
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=tu_api_key_aqui
DEFAULT_MODEL=gpt-4

# Configuración Común
TEMPERATURE=0.3
MAX_TOKENS=4000

# Application Configuration
NEXT_PUBLIC_APP_NAME=Banorte Sentiment Analysis
